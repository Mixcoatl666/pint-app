# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env

# Base de datos SQLite (se crea en prisma/dev.db con `pnpm prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones JWT. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la app
AUTH_URL="http://localhost:3000"
